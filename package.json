{
  "name": "@kanop.ai/agent-blueprint-harness",
  "version": "0.1.8",
  "description": "Runtime agent harness: blueprints, sessions, fragments, activities",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "docs",
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "test": "tsx test/run.ts",
    "build": "tsup && node -e \"const fs=require('fs'),s='dist/index.d.ts',d='dist/types.d.ts';if(fs.existsSync(s)){fs.rmSync(d,{force:true});fs.renameSync(s,d)}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typewatch": "tsc -p tsconfig.json --watch --noEmit",
    "prepack": "npm run build && node scripts/strip-dev-exports.mjs",
    "postpack": "node scripts/restore-dev-exports.mjs",
    "version:bump": "npm version patch --no-git-tag-version",
    "release": "npm run version:bump && npm publish --access public",
    "pack": "npm run version:bump && npm pack"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@jointhedots/scripting": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acorn": "^8.17.0",
    "openai": "^6.46.0",
    "pino": "^10.3.1",
    "pino-pretty": "^11.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
